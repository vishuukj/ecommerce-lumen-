{
  "version": 2,
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.js?__path=/api/:path*" },
    { "source": "/uploads/:path*", "destination": "/api/index.js?__path=/uploads/:path*" },
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/admin/", "destination": "/admin.html" },
    { "source": "/runway", "destination": "/runway.html" },
    { "source": "/runway/", "destination": "/runway.html" }
  ]
}
